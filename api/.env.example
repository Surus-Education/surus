DATABASE_URL=postgres://surus:surus@localhost:5432/surus_dev?sslmode=disable
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback
POSTMARK_API_KEY=
POSTMARK_FROM_EMAIL=noreply@yourdomain.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=surus-uploads
R2_PUBLIC_URL=
MAGIC_LINK_BASE_URL=http://localhost:3000/auth/magic-link/verify

# Primary frontend origin. Always allowed by CORS, and used for post-auth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Additional allowed CORS origins, comma-separated. Needed in production
# because the web app is a separate Vercel project on a different origin.
#
# Deployment is production-only, so this should be one exact origin. A single
# "*" wildcard per entry is supported but should be left unused — a bare
# https://*.vercel.app would let any site on vercel.app make credentialed
# requests against this API and read user data.
#
# CORS_ALLOWED_ORIGINS=https://surus.example.com

# "development" keeps cookies on SameSite=Lax without Secure, for plain-HTTP
# localhost. Anything else switches them to SameSite=None; Secure, which is
# required for the deployed cross-origin setup.
APP_ENV=development
PORT=8080
